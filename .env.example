# Copia este archivo como ".env" para desarrollo LOCAL únicamente.
# En Replit, configura estas mismas variables en la pestaña "Secrets"
# (candado en la barra lateral) — NUNCA las subas al repositorio.

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_de_twilio

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo a usar (opcional, por defecto claude-opus-5)
CLAUDE_MODEL=claude-opus-5
# Tokens máximos por respuesta (opcional, por defecto 1024)
CLAUDE_MAX_TOKENS=1024
# Esfuerzo de razonamiento: low | medium | high | xhigh | max (opcional, por defecto low)
CLAUDE_EFFORT=low

# --- Google Sheets ---
# URL completa de la hoja de cálculo de Google Sheets ya creada
# (ver README.md, sección "Configurar Google Sheets").
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/XXXXXXXXXXXXXXXXXXXXXXXXX/edit
# Contenido COMPLETO del archivo JSON de la cuenta de servicio de Google
# (todo en una sola línea). Ver README.md.
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}

# --- Negocio (opcional) ---
BUSINESS_NAME=Mi Empresa

# --- Palabras clave de calificación de prospectos (opcional) ---
# Formato: palabra=Etiqueta,palabra2=Etiqueta2
PROSPECT_KEYWORDS=consulta=Consulta General,precio=Consulta de Precio,informacion=Solicitud de Información,venta=Interés de Venta,necesito=Necesidad Expresada

# --- Seguridad (opcional) ---
# Poner en "false" SOLO para pruebas locales sin Twilio real.
VALIDATE_TWILIO_SIGNATURE=true

# --- Servidor (opcional) ---
PORT=8080
LOG_LEVEL=INFO
